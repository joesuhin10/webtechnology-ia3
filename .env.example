# ========================================================
# SmartStation - MongoDB Atlas Environment Configuration
# ========================================================

# Replace with your MongoDB Atlas connection URI:
# e.g., mongodb+srv://myUser:myPassword@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Target database name
MONGODB_DB=smartstation
